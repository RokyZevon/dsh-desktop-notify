{
  "name": "@rokyzevon/dsh-desktop-notify",
  "version": "0.1.0",
  "type": "module",
  "description": "Sends one system notification when a turn finishes or DSH needs your input while the window is not in the foreground",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RokyZevon/dsh-desktop-notify.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "dsh": "^0.2.3-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-session-status"
      ]
    }
  }
}
